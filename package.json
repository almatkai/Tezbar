{
  "name": "tezbar",
  "version": "0.3.0-beta.11",
  "private": true,
  "description": "Tezbar",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/native/dev.mjs",
    "build": "node scripts/native/build.mjs --release",
    "native:check": "node scripts/native/build.mjs --check",
    "native:build": "node scripts/native/build.mjs",
    "native:preview:package": "node scripts/native/build.mjs --local-preview",
    "build:windows": "node scripts/build-windows.mjs",
    "release:build": "node scripts/native/release.mjs",
    "release:test": "node --test scripts/release-policy.test.mjs scripts/embedding-runtime-policy.test.mjs scripts/macos-signing.test.mjs scripts/native/release.test.mjs",
    "preview": "node scripts/native/dev.mjs --release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "test:extension-worker": "pnpm build:backend && tsx scripts/test-extension-worker.ts",
    "build:native:axhelper": "./native/axhelper/build.sh",
    "build:native:screenocr": "./native/screenocr/build.sh",
    "build:native:color-picker": "./native/color-picker/build.sh",
    "build:native:image-colors": "./native/image-colors/build.sh",
    "build:native": "node scripts/build-native.mjs",
    "dist": "pnpm build",
    "build:backend": "pnpm exec tsx scripts/build-backend.ts",
    "start": "node scripts/native/dev.mjs",
    "ui:check": "node scripts/native/ui-policy.mjs --check",
    "icons:sync": "node scripts/sync-icons.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "esbuild": "^0.28.0",
    "fuse.js": "^7.3.0",
    "sqlite-vec": "0.1.7-alpha.10"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.28.0",
    "@esbuild/darwin-x64": "0.28.0",
    "@esbuild/win32-arm64": "0.28.0",
    "@esbuild/win32-x64": "0.28.0"
  },
  "devDependencies": {
    "@raycast/api": "^1.104.13",
    "@shadcn/helpers": "0.3.0",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.14.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.6",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "dompurify": "^3.4.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "highlight.js": "^11.11.1",
    "jsdom": "^26.1.0",
    "marked": "^18.0.2",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.3",
    "vitest": "^3.1.2",
    "@ai-sdk/react": "4.0.147",
    "ai": "7.0.143"
  },
  "packageManager": "pnpm@11.17.0"
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@tezbar/desktop-runtime": ["src/main/desktop-runtime.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "tests/oracles/legacy-renderer/**/*.ts",
    "tests/oracles/legacy-renderer/**/*.tsx",
    "src/shared/**/*.ts"
  ]
}

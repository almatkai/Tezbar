{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tezbar.app/schemas/extension-v2.schema.json",
  "title": "Tezbar bundled Native V2 extension",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "name", "version", "runtime", "replaces", "commands", "verification", "icon"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^com\\.tezbar\\.native\\.[a-z0-9][a-z0-9-]*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "icon": { "type": "string", "pattern": "^/extensions/(icons|artwork)/[a-z0-9-]+\\.(png|webp|svg)$" },
    "artwork": { "type": "string", "pattern": "^/extensions/(icons|artwork)/[a-z0-9-]+\\.(png|webp|svg)$" },
    "artworkBackground": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "runtime": { "const": "rust" },
    "replaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^raycast\\." } },
    "platforms": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/platform" } },
    "preferences": { "type": "array", "items": { "type": "object" } },
    "commands": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["name", "platforms", "runtime"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/platform" } },
          "runtime": { "enum": ["rust", "javascript", "unavailable"] },
          "gap": { "type": "string" }
        }, "additionalProperties": true }
    },
    "verification": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "required": ["platform", "state"],
        "properties": {
          "platform": { "$ref": "#/$defs/platform" },
          "state": { "enum": ["pass", "fail", "not-run"] },
          "note": { "type": "string" },
          "verifiedAt": { "type": "string" },
          "verifiedCommit": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "platform": { "enum": ["macOS", "Windows", "Linux"] }
  }
}

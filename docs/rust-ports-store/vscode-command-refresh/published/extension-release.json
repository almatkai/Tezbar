  "preferences": [
    {
      "name": "build",
      "type": "dropdown",
      "required": false,
      "title": "Build",
      "default": "Code",
      "description": "Select which build of Visual Studio Code to use when searching for recent projects",
      "data": [
        {
          "title": "Antigravity",
          "value": "Antigravity"
        },
        {
          "title": "Cursor",
          "value": "Cursor"
        },
        {
          "title": "IBM Bob",
          "value": "IBM Bob"
        },
        {
          "title": "Kiro",
          "value": "Kiro"
        },
        {
          "title": "Positron",
          "value": "Positron"
        },
        {
          "title": "Qoder",
          "value": "Qoder"
        },
        {
          "title": "Trae",
          "value": "Trae"
        },
        {
          "title": "Trae CN",
          "value": "Trae CN"
        },
        {
          "title": "VSCodium",
          "value": "VSCodium"
        },
        {
          "title": "VSCodium - Insiders",
          "value": "VSCodium - Insiders"
        },
        {
          "title": "Visual Studio Code",
          "value": "Code"
        },
        {
          "title": "Visual Studio Code - Insiders",
          "value": "Code - Insiders"
        },
        {
          "title": "Devin",
          "value": "Devin"
        },
        {
          "title": "Windsurf",
          "value": "Windsurf"
        },
        {
          "title": "Lingma",
          "value": "Lingma"
        }
      ]
    },
    {
      "name": "layout",
      "title": "View Layout",
      "type": "dropdown",
      "required": false,
      "default": "list",
      "description": "Select the layout of the view",
      "data": [
        {
          "value": "list",
          "title": "List"
        },
        {
          "value": "grid",
          "title": "Grid"
        }
      ]
    },
    {
      "name": "keepSectionOrder",
      "type": "checkbox",
      "title": "Advanced",
      "required": false,
      "label": "Keep Section Order",
      "default": false,
      "description": "Keep the order of the sections while searching folders, files, etc."
    },
    {
      "name": "closeOtherWindows",
      "type": "checkbox",
      "title": "Usability",
      "required": false,
      "label": "Close Other VS Code Windows",
      "default": false,
      "description": "Close other VS Code windows when opening a project"
    },
    {
      "name": "terminalApp",
      "type": "appPicker",
      "default": "com.apple.Terminal",
      "required": false,
      "title": "Terminal App",
      "description": "Select which Terminal App to use when opening with a terminal"
    },
    {
      "name": "showGitBranch",
      "type": "checkbox",
      "title": "Git Integration",
      "required": false,
      "label": "Show Git Branch",
      "default": true,
      "description": "Display the current Git branch for files and folders in Git repositories"
    },
    {
      "name": "gitBranchColor",
      "type": "textfield",
      "title": "Git Integration Color",
      "required": false,
      "label": "Git Branch Color",
      "default": "",
      "description": "Hexadecimal color code for Git branch tag (e.g., #00FF00). Leave empty to use default green"
    }
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "schemaVersion": 3,
  "id": "com.tezbar.native.visual-studio-code",
  "slug": "visual-studio-code",
  "name": "Visual Studio Code",
  "runtime": "rust",
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/visual-studio-code",
  "icon": "resources/icon.png",
  "commands": [
    {
      "name": "index",
      "title": "Search Recent Projects",
      "description": "Search and open recent projects from VS Code",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "open-with-vscode",
      "title": "Open with Visual Studio Code",
      "description": "Open the currently selected file manager item with VS Code",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "open-new-window",
      "title": "Open New Window",
      "description": "Open a new VS Code window",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "extensions",
      "title": "Show Installed Extensions",
      "description": "Manage installed extensions",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "install-extension",
      "title": "Install Extension",
      "description": "Install extensions from Visual Studio Marketplace",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "commandpalette",
      "title": "Commands",
      "description": "Show commands of the VS Code Command Palette",
      "disabledByDefault": true,
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    },
    {
      "name": "open-agents-window",
      "title": "Open Agents Window",
      "description": "Open the Agents Window",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "timeoutMs": 30000
    }
  ],
  "capabilities": [
    "clipboard.write",
    "shell",
    "selection",

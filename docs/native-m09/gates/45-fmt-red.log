+    pub(super) fn schedule_viewport(&mut self, w: &mut Window, cx: &mut Context<Self>) {
+        if self.viewport_pending || !self.visible {
+            return;
+        }
+        self.viewport_pending = true;
+        let owner = cx.entity().downgrade();
+        w.on_next_frame(move |w, cx| {
+            let _ = owner.update(cx, |v, cx| {
+                v.viewport_pending = false;
+                if !v.visible {
+                    return;
+                }
+                let t = tezbar_ui::tokens::tokens(w);
+                let grid = v
+                    .session
+                    .as_ref()
+                    .is_some_and(|s| s.root.kind == NodeKind::Grid);
+                let columns = if grid {
+                    v.session
+                        .as_ref()
+                        .and_then(|s| s.root.props.get("columns"))
+                        .and_then(Value::as_u64)
+                        .unwrap_or(5)
+                        .clamp(1, 12) as usize
+                } else {
+                    1
+                };
+                let row = if grid { 148. } else { tezbar_ui::tokens::ROW } * t.zoom;
+                let scroll = v.list_scroll.0.borrow();
+                let top = ((-f32::from(scroll.base_handle.offset().y) / row)
+                    .max(0.)
+                    .floor() as usize)
+                    * columns;
+                let count = ((f32::from(scroll.base_handle.bounds().size.height) / row)
+                    .ceil()
+                    .max(1.) as usize
+                    + 2)
+                    * columns;
+                drop(scroll);
+                v.viewport = top.saturating_sub(columns)
+                    ..top.saturating_add(count.min(108)).min(v.rows.len());
+                v.prepare_images(cx);
+                cx.notify();
+            });
+        });
     }
 }
 

+use std::{cell::Cell, rc::Rc};
+fn hsv(h: f32, s: f32, v: f32, a: f32) -> Hsla {
+    let c = v * s;
+    let h = h / 60.;
+    let x = c * (1. - (h % 2. - 1.).abs());
+    let (r, g, b) = match h as u32 {
+        0 => (c, x, 0.),
+        1 => (x, c, 0.),
+        2 => (0., c, x),
+        3 => (0., x, c),
+        4 => (x, 0., c),
+        _ => (c, 0., x),
+    };
+    rgba(
+        ((255. * (r + v - c)) as u32) << 24
+            | ((255. * (g + v - c)) as u32) << 16
+            | ((255. * (b + v - c)) as u32) << 8
+            | (255. * a) as u32,
+    )
+    .into()
 }

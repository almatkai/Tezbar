  "api_handoff": {
    "executor": "App constructs one SettingsStore from CoreClient; Settings, Onboarding and Launcher picker share it. No additional runtime/config writer.",
    "picker": "enqueue typed Select+Activate edits; drain_owner(owner) waits for config settlement and checks owner_failure_count, independent of unrelated operations.",
    "close_quit": "drain_with(EffectBarrier) waits all admitted operations/config and durable parent UI-state writes, then rechecks. Native close_failed(generation,error,cx) fences late errors.",
    "settings_navigation": "direct SettingsContent::navigate(&Navigation,window,cx); acknowledge admission once and preserve Launcher.navigation and retained main entity.",
    "project_review": "Owner::settings_project_review(cwd,nonce,cx) is currently unused until M8 wiring; SettingsContent::review_project selects AI, coalesces UI nonce and uses core projectReviewId for trust/dismiss.",
    "onboarding": "boot_gate after successful coreReady only, one 400ms retry then fail-open. OnboardingEffect::Finished carries entity identity through the parent Relay event. Finish/Skip await durable save.",
    "voice": "existing voice:stt:modes plus all-listed-model selection; partial-file Delete and targeted CancelDownload; no implicit download on selection.",
    "extensions": "M7 owns installed-extension Settings. M9 reuses production Preferences::merge/partitioning, no duplicate writer. BrowseStore routes to Surface::Extensions with fresh nonce after successful close."
  },

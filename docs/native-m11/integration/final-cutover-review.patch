+
+    if (e.key === 'ArrowDown') {
+      e.preventDefault()
+      setSelected((i) => Math.min(i + 1, filtered.length - 1))
+      return
+    }
+
+    if (e.key === 'ArrowUp') {
+      e.preventDefault()
+      setSelected((i) => Math.max(i - 1, 0))
+      return
+    }
+
+    const entry = filtered[selected]
+    if (!entry) return
+
+    if (e.key === 'Enter') {
+      e.preventDefault()
+      void copyBack(entry)
+      return
+    }

+// src-tauri/src/updater.rs
+//
+// GitHub Releases–based update tracking using tauri-plugin-updater.
+
+use crate::release_channels::{self, ReleaseChannel};
+use serde::Serialize;
+use std::sync::Mutex;
+use tauri::{AppHandle, Emitter, Manager};
+use tauri_plugin_updater::{Update, UpdaterExt};
+
+pub use tezbar_update::AppUpdateStatus;
+pub struct UpdaterState {
+    operation: tokio::sync::Mutex<()>,
+    status: Mutex<AppUpdateStatus>,
+    pending: Mutex<Option<Update>>,
+}
+
+impl Default for UpdaterState {
+    fn default() -> Self {
+        Self {
+            operation: tokio::sync::Mutex::new(()),
+            status: Mutex::new(AppUpdateStatus::Idle),
+            pending: Mutex::new(None),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct UpdateChannelInfo {
+    channel: ReleaseChannel,
+    version: String,
+}
+
+fn selected_channel(app: &AppHandle) -> Result<ReleaseChannel, String> {
+    let directory = app.path().app_local_data_dir().map_err(|e| e.to_string())?;
+    release_channels::read_channel(
+        &directory,
+        &app.config().identifier,
+        &app.package_info().version,
+    )
+}
+
+#[tauri::command]
+pub async fn get_update_channel(app: AppHandle) -> Result<UpdateChannelInfo, String> {
+    let state = app.state::<UpdaterState>();
+    let _operation = state.operation.lock().await;
+    channel_info(&app)
+}
+
+fn channel_info(app: &AppHandle) -> Result<UpdateChannelInfo, String> {
+    Ok(UpdateChannelInfo {
+        channel: selected_channel(app)?,
+        version: app.package_info().version.to_string(),
+    })
+}
+
+#[tauri::command]
+pub async fn set_update_channel(
+    app: AppHandle,
+    channel: ReleaseChannel,
+) -> Result<UpdateChannelInfo, String> {
+    let state = app.state::<UpdaterState>();
+    let _operation = state.operation.lock().await;
+    if matches!(
+        current_status(&app),
+        AppUpdateStatus::Downloading { .. } | AppUpdateStatus::Ready { .. }
+    ) {
+        return Err("Finish the current update before changing channels".into());
+    }
+    if app.config().identifier != release_channels::NORMAL_APP_ID {
+        return Err("This installation has an unsupported updater identity".into());
+    }
+    let directory = app.path().app_local_data_dir().map_err(|e| e.to_string())?;
+    release_channels::write_channel(&directory, channel)?;
+    *state.pending.lock().unwrap() = None;
+    set_status(&app, AppUpdateStatus::Idle);
+    channel_info(&app)
+}
+
+fn validate_update(
+    app: &AppHandle,
+    channel: ReleaseChannel,
+    update: &Update,
+) -> Result<(), String> {
+    let version = semver::Version::parse(&update.version).map_err(|e| e.to_string())?;
+    release_channels::validate_manifest_identity(
+        channel,
+        &app.config().identifier,
+        &version,
+        &update.raw_json,
+    )?;
+    validate_download_url(&version, &update.download_url)
+}
+
+use tezbar_update::validate_download_url;
+
+fn set_status(app: &AppHandle, status: AppUpdateStatus) {
+    log::info!("Updater status set to: {status:?}");
+    if let Some(state) = app.try_state::<UpdaterState>() {
+        *state.status.lock().unwrap() = status.clone();
+    }
+    if let Err(error) = app.emit("update-status", status) {
+        log::debug!("failed to emit update-status: {error}");
+    }
+}
+
+fn current_status(app: &AppHandle) -> AppUpdateStatus {
+    app.try_state::<UpdaterState>()
+        .map(|state| state.status.lock().unwrap().clone())
+        .unwrap_or(AppUpdateStatus::Idle)
+}
+
+use tezbar_update::{github_release_url, manual_status, published_release_status};
+
+/// Returns true if the updater error indicates that the current platform was not
+/// found in the release manifest's platforms map.
+pub fn is_platform_not_found_error(error: &tauri_plugin_updater::Error) -> bool {
+    matches!(
+        error,
+        tauri_plugin_updater::Error::TargetNotFound(_)
+            | tauri_plugin_updater::Error::TargetsNotFound(_)
+    )
+}
+
+#[allow(dead_code)]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct UpdateMetadata {
+    pub version: String,
+    pub notes: String,
+    pub release_url: String,
+}
+
+#[allow(dead_code)]
+pub fn resolve_update_status(
+    check_result: Result<Option<UpdateMetadata>, &tauri_plugin_updater::Error>,
+    current_version: &str,
+) -> AppUpdateStatus {
+    match check_result {
+        Ok(Some(meta)) => AppUpdateStatus::Available {
+            version: meta.version,
+            notes: meta.notes,
+            release_url: meta.release_url,
+        },
+        Ok(None) => AppUpdateStatus::UpToDate {
+            version: current_version.to_string(),
+        },
+        Err(err) if is_platform_not_found_error(err) => AppUpdateStatus::UpToDate {
+            version: current_version.to_string(),
+        },
+        Err(err) => AppUpdateStatus::Error {
+            message: err.to_string(),
+        },
+    }
+}
+
+#[tauri::command]
+pub async fn get_update_status(app: AppHandle) -> Result<AppUpdateStatus, String> {
+    Ok(current_status(&app))
+}
+
+#[tauri::command]
+pub async fn check_for_updates(app: AppHandle) -> Result<AppUpdateStatus, String> {
+    let state = app.state::<UpdaterState>();
+    let _operation = state.operation.lock().await;
+    if matches!(
+        current_status(&app),
+        AppUpdateStatus::Downloading { .. } | AppUpdateStatus::Ready { .. }
+    ) {
+        return Ok(current_status(&app));
+    }
+    *state.pending.lock().unwrap() = None;
+    let channel = selected_channel(&app)?;
+    log::info!("Updater: check_for_updates requested");
+    set_status(&app, AppUpdateStatus::Checking);
+
+    let os_info = if cfg!(target_os = "windows") {
+        "Windows; Windows NT"
+    } else if cfg!(target_os = "macos") {
+        "Macintosh; Intel Mac OS X"
+    } else {
+        "Linux; X11"
+    };
+    let current_version = app.package_info().version.to_string();
+    let user_agent = format!("Tezbar-App/{current_version} ({os_info})");
+
+    let updater = app
+        .updater_builder()
+        .endpoints(
+            channel
+                .endpoints()
+                .iter()
+                .map(|url| url.parse())
+                .collect::<Result<Vec<_>, _>>()
+                .map_err(|e| format!("Invalid update endpoint: {e}"))?,
+        )
+        .map_err(|e| e.to_string())?
+        .timeout(std::time::Duration::from_secs(15))
+        .header("User-Agent", user_agent)
+        .map_err(|e| e.to_string())?
+        .version_comparator(move |current, release| {
+            // Offer updates that are strictly newer than the running build.
+            release.version > current && channel.accepts(&release.version)
+        })
+        .build()
+        .map_err(|e| e.to_string())?;
+
+    let current = app.package_info().version.clone();
+    let (result, published) = tokio::join!(
+        updater.check(),
+        crate::manual_releases::check(&current, channel)
+    );
+
+    match result {
+        Ok(Some(update)) => {
+            if let Err(message) = validate_update(&app, channel, &update) {
+                let status = AppUpdateStatus::Error { message };
+                set_status(&app, status.clone());
+                return Ok(status);
+            }
+            if let Ok(Some(ref release)) = published {
+                if release.version > semver::Version::parse(&update.version).unwrap() {
+                    let status = manual_status(release);
+                    set_status(&app, status.clone());
+                    return Ok(status);
+                }
+            }
+            let version = update.version.clone();
+            let notes = update.body.clone().unwrap_or_default();
+            // tag is embedded in the version string; release page URL is derived
+            // from the configured endpoints' repository.
+            let release_url = github_release_url(&format!("v{version}"), "");
+            if let Some(state) = app.try_state::<UpdaterState>() {
+                *state.pending.lock().unwrap() = Some(update);
+            }
+            let status = AppUpdateStatus::Available {
+                version,
+                notes,
+                release_url,
+            };
+            set_status(&app, status.clone());
+            Ok(status)
+        }
+        Ok(None) => {
+            if let Some(state) = app.try_state::<UpdaterState>() {
+                *state.pending.lock().unwrap() = None;
+            }
+            let version = app.package_info().version.to_string();
+            let status = published_release_status(published, &version, None);
+            set_status(&app, status.clone());
+            Ok(status)
+        }
+        Err(ref error) if is_platform_not_found_error(error) => {
+            log::info!(
+                "Updater: no signed artifact for this architecture ({error:?}); checking published installers."
+            );
+            if let Some(state) = app.try_state::<UpdaterState>() {
+                *state.pending.lock().unwrap() = None;
+            }
+            let version = app.package_info().version.to_string();
+            let status = published_release_status(published, &version, None);
+            set_status(&app, status.clone());
+            Ok(status)
+        }
+        Err(error) => {
+            log::error!("Updater: check error: {error:?}");
+            let signed_error = if matches!(error, tauri_plugin_updater::Error::ReleaseNotFound) {
+                None
+            } else {
+                Some(error.to_string())
+            };
+            let status = published_release_status(published, &current_version, signed_error);
+            set_status(&app, status.clone());
+            Ok(status)
+        }
+    }
+}

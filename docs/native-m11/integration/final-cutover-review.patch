+  html.platform-windows .drag-region * {
+    -webkit-app-region: no-drag;
+  }
+
+  .no-drag,
+  input,
+  textarea,
+  select,
+  button,
+  a[href],
+  [role='button'],
+  [role='menuitem'],
+  [role='option'],
+  [contenteditable='true'],
+  [class*='overflow-y-auto'],
+  [class*='overflow-auto'],
+  [class*='overflow-y-scroll'] {
+    -webkit-app-region: no-drag;
+  }

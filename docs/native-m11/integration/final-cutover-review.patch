+/* Native service status also renders before the main application chunk loads. */
+.backend-connection {
+  position: fixed;
+  inset: 8px;
+  z-index: 10000;
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 24px;
+  background: rgb(var(--c-panel));
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  border-radius: var(--r-panel);
+}
+
+.backend-connection--banner {
+  top: auto;
+  padding: 12px 16px;
+}
+
+.backend-connection__retry {
+  flex-shrink: 0;
+  padding: 8px 12px;
+  border-radius: 6px;
+  background: rgba(255, 255, 255, 0.1);
+  color: inherit;
+  font-size: 12px;
+}
+
+.backend-connection__retry:focus-visible {
+  outline: 2px solid currentColor;
+  outline-offset: 2px;
+}
+
+.backend-connection__retry:disabled {
+  opacity: 0.5;
+}
+
+:root[data-theme='white'] .backend-connection {
+  border-color: rgba(76, 94, 125, 0.2);
+  color: rgb(var(--c-text-1));
+}
+
+:root[data-theme='white'] .backend-connection__retry {
+  background: rgba(78, 98, 136, 0.1);
+}
+
+/* Tauri's hidden WebView2 window remains document-visible on Windows. Remove
+   the launcher from layout until the native host shows it again so animated
+   indicators and transparent compositing do not run while idle. */
+html.tezbar-window-hidden body {
+  display: none;
+}
+/* =========================================================================
+   Design system v2 — flat sheets
+   -------------------------------------------------------------------------
+   Shared by every surface. Flat, frosted sheets with 1px hairlines instead
+   of gradients and glow; solid color squircle icons; a solid accent for the
+   primary selection. Tokens are theme-aware, so each rule below is written
+   once and paired with its light-theme selector only to outrank the older
+   theme rules above. Reusable pieces live in `ui/primitives.tsx`
+   (ListRow, ListRowTag, SectionLabel, Hint) and `launcherIcons.tsx`
+   (Squircle).
+   ========================================================================= */
+:root {
+  --r-panel: 10px;
+  --r-card: 10px;
+  --r-row: 8px;
+  --r-field: 7px;
+  --r-chip: 5px;
+  --r-window: 18px;
+
+  --ln-accent: #4f52d9;
+  --ln-accent-strong: #5b5ef0;
+  --ln-accent-hover: #6a6df4;
+  --ln-sheet: rgba(28, 29, 33, 0.95);
+  --ln-rim: rgba(255, 255, 255, 0.08);
+  --ln-panel: rgba(255, 255, 255, 0.025);
+  --ln-field: rgba(0, 0, 0, 0.22);
+  --ln-popover: rgba(32, 33, 38, 0.98);
+  --ln-popover-solid: rgb(32, 33, 38);
+  --ln-hairline: rgba(255, 255, 255, 0.065);
+  --ln-hover: rgba(255, 255, 255, 0.05);
+  --ln-selected: rgba(255, 255, 255, 0.07);
+  --ln-bar: rgba(0, 0, 0, 0.16);
+  --ln-pill: rgba(255, 255, 255, 0.06);
+  --ln-pill-strong: rgba(255, 255, 255, 0.09);
+  --ln-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
+  --ln-bar-float: rgba(22, 23, 27, 0.78);
+}
+
+:root[data-theme='white'] {
+  --ln-sheet: rgba(250, 250, 251, 0.96);
+  --ln-rim: rgba(15, 23, 42, 0.2);
+  --ln-panel: rgba(255, 255, 255, 0.7);
+  --ln-field: rgba(255, 255, 255, 0.9);
+  --ln-popover: rgba(255, 255, 255, 0.98);
+  --ln-popover-solid: rgb(255, 255, 255);
+  --ln-hairline: rgba(15, 23, 42, 0.1);
+  --ln-hover: rgba(15, 23, 42, 0.045);
+  --ln-selected: rgba(15, 23, 42, 0.06);
+  --ln-bar: rgba(15, 23, 42, 0.025);
+  --ln-pill: rgba(15, 23, 42, 0.05);
+  --ln-pill-strong: rgba(15, 23, 42, 0.07);
+  --ln-shadow: 0 16px 40px rgba(15, 23, 42, 0.14);
+  --ln-bar-float: rgba(247, 247, 249, 0.82);
+}
+
+/* ---- Surfaces ---- */
+.glass-shell,
+.glass-shell.glass-shell--terminal,
+:root[data-theme='white'] .glass-shell,
+:root[data-theme='white'] .glass-shell.glass-shell--terminal {
+  border: 0;
+  border-radius: var(--r-window);
+  background: var(--ln-sheet);
+  backdrop-filter: blur(40px) saturate(180%);
+  -webkit-backdrop-filter: blur(40px) saturate(180%);
+  box-shadow: none;
+}
+
+/* The window has no native shadow, so the rim is its only edge. Paint it
+   above the content: header, footer and rows have their own backgrounds and
+   would otherwise cover an inset shadow on the shell itself. */
+.glass-shell::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  z-index: 100;
+  border-radius: inherit;
+  box-shadow: inset 0 0 0 1px var(--ln-rim);
+  pointer-events: none;
+}
+
+.glass-card,
+.glass-panel,
+:root[data-theme='white'] .glass-card,
+:root[data-theme='white'] .glass-panel {
+  border-radius: var(--r-card);
+  background: var(--ln-panel);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+  box-shadow: inset 0 0 0 1px var(--ln-hairline);
+}
+
+.glass-inset,
+:root[data-theme='white'] .glass-inset {
+  background: var(--ln-pill);
+  box-shadow: inset 0 0 0 1px var(--ln-hairline);
+}
+
+.agent-chat-shell,
+:root[data-theme='white'] .agent-chat-shell {
+  border-color: var(--ln-hairline);
+  background: var(--ln-panel);
+  box-shadow: none;
+}
+
+.tezbar-settings-window,
+:root[data-theme='white'] .tezbar-settings-window {
+  border-color: var(--ln-rim);
+  background: var(--ln-sheet);
+  box-shadow: var(--ln-shadow);
+}
+
+.cleanmymac-sidebar {
+  background: var(--ln-bar);
+}
+
+.tezbar-popover,
+:root[data-theme='white'] .tezbar-popover {
+  border-color: var(--ln-rim);
+  background: var(--ln-popover);
+  box-shadow: var(--ln-shadow);
+}
+
+/* Terminal glyphs must not bleed through the session picker. Keep it out of
+   the translucent glass-card surface rules and opaque in both themes. */
+.tezbar-popover.terminal-sessions-menu,
+:root[data-theme='white'] .tezbar-popover.terminal-sessions-menu {
+  background: var(--ln-popover-solid);
+}
+
+.hairline,
+:root[data-theme='white'] .hairline {
+  background: var(--ln-hairline);
+}
+
+/* ---- Fields and buttons ---- */
+.glass-field,
+:root[data-theme='white'] .glass-field {
+  background: var(--ln-field);
+  color: rgb(var(--c-text-1));
+  box-shadow: inset 0 0 0 1px var(--ln-hairline);
+}
+
+.glass-field:hover,
+:root[data-theme='white'] .glass-field:hover {
+  background: var(--ln-field);
+  box-shadow: inset 0 0 0 1px var(--ln-rim);
+}
+
+.glass-field:focus,
+.glass-field:focus-visible,
+:root[data-theme='white'] .glass-field:focus,
+:root[data-theme='white'] .glass-field:focus-visible {
+  background: var(--ln-field);
+  box-shadow: inset 0 0 0 1px var(--ln-accent-strong);
+}
+
+.btn-primary,
+:root[data-theme='white'] .btn-primary {
+  color: #fff;
+  background: var(--ln-accent-strong);
+  box-shadow: none;
+}

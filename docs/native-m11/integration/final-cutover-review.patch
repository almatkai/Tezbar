+function plainTextToRichHtml(text: string): string {
+  const cleaned = stripMarkdownSyntax(text).replace(/\r/g, '').trim()
+  if (!cleaned) return '<div><br></div>'
+  return cleaned
+    .split('\n')
+    .map((line) => (line.trim().length > 0 ? `<div>${escapeHtml(line)}</div>` : '<div><br></div>'))
+    .join('')

+    setCopiedKey(key)
+    window.setTimeout(() => setCopiedKey((current) => (current === key ? null : current)), 900)
+  }
+
+  return (
+    <div className="grid h-full min-h-[420px] max-h-[540px] grid-rows-[minmax(0,1fr)] grid-cols-[minmax(0,1fr)_min(45%,320px)] gap-4">

+        return
+      }
+      onBack()
+    }
+    window.addEventListener('keydown', onEsc, true)
+    return () => window.removeEventListener('keydown', onEsc, true)
+  }, [onBack, query])
+
+  const searchResults = useMemo(() => searchEmojis(query, category), [query, category])
+
+  const grouped = useMemo(() => {

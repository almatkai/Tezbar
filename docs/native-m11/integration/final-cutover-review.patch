+function rootKind(root: ExtensionRuntimeNode): 'list' | 'form' | 'grid' | 'detail' {
+  if (root.type.startsWith('Form')) return 'form'
+  if (root.type.startsWith('Grid')) return 'grid'
+  if (root.type.startsWith('Detail')) return 'detail'
+  return 'list'

+        ref={chipRef}
+        type="button"
+        aria-label="Change icon"
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        aria-controls={open ? dialogId : undefined}
+        className={cx(VAULT_ICON_CHIP_CLASS, 'transition hover:bg-white/[0.08]')}
+        onClick={() => {
+          if (open) close()

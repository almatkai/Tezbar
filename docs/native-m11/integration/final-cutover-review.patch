-      }
-      context.drawImage(image, 0, 0, QR_EXPORT_SIZE, QR_EXPORT_SIZE)
-      resolve(canvas.toDataURL('image/png'))
-    }
-    image.onerror = () => reject(new Error('Could not render QR image'))
-    image.src = svgDataUrl
-  })
-}

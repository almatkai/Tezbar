+                    else focusCell(index + offset)
+                  }}
+                >
+                  <VaultIconGlyph entry={entry} />
+                </button>
+              ))}
+            </div>
+            <button
+              type="button"
+              className="mt-2 text-[11.5px] text-ink-3 transition hover:text-ink-1"
+              onClick={() => choose(undefined)}
+            >
+              Use default
+            </button>
+          </div>,
+          document.body
+        )}
+    </>
+  )
+}

-                .set_position(LogicalPosition::new(logical.x, logical.y))
-                .map_err(|error| error.to_string())?;
-        }
-        #[cfg(not(target_os = "macos"))]
-        overlay
-            .set_position(PhysicalPosition::new(position.x, position.y))
-            .map_err(|error| error.to_string())?;
-    }
-    if needs_size_update {
-        #[cfg(target_os = "macos")]

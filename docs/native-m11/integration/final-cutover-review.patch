+function optionSuffix(variant: SemanticVariantStatus) {
+  if (variant.failure?.stage === 'startup') return " — couldn't start"
+  switch (variant.state) {
+    case 'not-downloaded':
+      return ' — download required'
+    case 'downloading':
+      return ' — downloading'
+    case 'verifying':
+      return ' — verifying'
+    case 'error':

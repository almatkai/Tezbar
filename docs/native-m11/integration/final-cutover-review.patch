-export function getPreferredDefaultTarget(): string {
-  const prefs = readPrefs()
-  if (prefs.pinned) return prefs.pinned
-  const top = listTargetUsage()[0]
-  return top?.code ?? INITIAL_DEFAULT_TARGET
-}

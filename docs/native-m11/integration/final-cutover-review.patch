+    ),
+    agentCancel: vi.fn(async () => ({ ok: true })),
+    onAgentEvent: (listener) => {
+      listeners.add(listener)
+      return () => {
+        listeners.delete(listener)
+      }
+    },
+  }
+  return {
+    api,
+    emit,
+    listeners,
+    chat: new Chat<AgentUIMessage>({ transport: createNativeAgentTransport(api, context) }),
+  }

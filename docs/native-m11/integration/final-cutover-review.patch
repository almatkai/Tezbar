+          <div className="flex min-h-0 w-[44%] max-w-[340px] flex-col overflow-hidden">
+            {filtered.length === 0 ? (
+              <EmptyState query={query} totalItems={entries.length} />
+            ) : (
+              <div className="min-h-0 flex-1 overflow-y-auto pr-0.5">

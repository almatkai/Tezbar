+/** Resolve the user's likely home currency from navigator + Intl (no hardcoded country). */
+export function inferDefaultCurrencyCode(): string {
+  if (typeof navigator !== 'undefined' && Array.isArray(navigator.languages)) {
+    for (const tag of navigator.languages) {
+      try {
+        const region = new Intl.Locale(tag).maximize().region
+        if (region) {
+          const code = REGION_TO_CURRENCY[region]
+          if (code) return code
+        }
+      } catch {
+        /* ignore */
+      }
+    }
+  }
+  try {
+    const loc = Intl.DateTimeFormat().resolvedOptions().locale
+    const region = new Intl.Locale(loc).maximize().region
+    if (region) {
+      const code = REGION_TO_CURRENCY[region]
+      if (code) return code
+    }
+  } catch {
+    /* ignore */
+  }
+  return 'USD'
+}

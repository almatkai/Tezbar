+  }, [calc, onTaskDone])
+
+  // Like the terminal card, getting into the mode is the skill being taught.
+  useEffect(() => {
+    if (mode.isAiMode) onTaskDone('ai')
+  }, [mode.isAiMode, onTaskDone])
+
+  useEffect(() => {
+    if (terminalMode) onTaskDone('terminal')
+  }, [terminalMode, onTaskDone])
+

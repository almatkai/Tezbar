-  /* ---- Window chrome ----
-     The launcher is frameless, so the OS only lets the user move the
-     window through regions that opt in via -webkit-app-region. The
-     outer app container marks itself as draggable; interactive
-     children (inputs, buttons, lists, scroll containers) opt back out
-     with .no-drag so the user can still click them. */
-  .drag-region {
-    -webkit-app-region: drag;
-  }
-
-  /* WebView2's native app-region drag bypasses the renderer mousedown event
-     that starts center snapping. The Windows host tracks the held cursor and
-     moves the window itself, so keep the main surface as ordinary web content. */
-  html.platform-windows .drag-region,
-  html.platform-windows .drag-region * {
-    -webkit-app-region: no-drag;
-  }
-
-  .no-drag,
-  input,
-  textarea,
-  select,
-  button,
-  a[href],
-  [role='button'],
-  [role='menuitem'],
-  [role='option'],
-  [contenteditable='true'],
-  [class*='overflow-y-auto'],
-  [class*='overflow-auto'],
-  [class*='overflow-y-scroll'] {
-    -webkit-app-region: no-drag;
-  }
-
-  /* Search dragging is threshold-based in windowDrag.ts, including over the
-     input. Native app-region dragging would swallow clicks before that handler. */
-  .command-search[data-window-search-drag],
-  .command-search[data-window-search-drag] * {
-    -webkit-app-region: no-drag;
-  }
-
-  /* ---- Surfaces ---- */
-
-  /* Outermost glass shell — the rounded floating card that wraps the window */
-  .glass-shell {
-    position: relative;
-    overflow: hidden;
-    border-radius: var(--r-window);
-    background:
-      linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 40%),
-      rgba(12, 13, 17, 0.92);
-    backdrop-filter: blur(48px) saturate(180%);
-    -webkit-backdrop-filter: blur(48px) saturate(180%);
-    box-shadow:
-      inset 0 1px 0 rgba(255, 255, 255, 0.08),
-      inset 0 0 0 1px rgba(255, 255, 255, 0.04);
-    /* Native resize frames must be immediate. Animating height clips the
-       footer outside the shrinking window until the transition catches up. */
-    transition: none;
-  }
-
-  .glass-shell.overflow-visible {
-    overflow: visible;
-  }
-
-  .glass-shell.glass-shell--terminal {
-    border-radius: var(--r-window);
-    background:
-      linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 40%),
-      rgba(12, 13, 17, 0.92);
-    backdrop-filter: blur(48px) saturate(180%);
-    -webkit-backdrop-filter: blur(48px) saturate(180%);
-    box-shadow: none;
-  }
-
-  /* xterm ships an opaque black viewport fallback. Keep its rendering layers
-     transparent so the terminal uses the surrounding glass card surface. */
-  .terminal-host .xterm,
-  .terminal-host .xterm-viewport,
-  .terminal-host .xterm-screen,
-  .terminal-host .xterm-scrollable-element {
-    background-color: transparent !important;
-  }
-
-  /* Mid-level glass panel — for view chrome inside the shell */
-  .glass-panel {
-    -webkit-app-region: drag;
-    position: relative;
-    border-radius: var(--r-panel);
-    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 60%);
-    box-shadow:
-      inset 0 1px 0 rgba(255, 255, 255, 0.05),
-      inset 0 0 0 1px rgba(255, 255, 255, 0.05);
-  }

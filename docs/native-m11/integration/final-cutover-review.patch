+const SEARCH_CATEGORY_LABELS: Record<SearchResult['category'], string> = {
+  applications: 'Application',
+  files: 'File',
+  knowledge: 'Document',
+  clipboard: 'Clipboard',
+  'quick-notes': 'Note',
+  vault: 'Vault',
+  extensions: 'Extension',
+  store: 'Store',
+  'mac-cli': 'Command',
+  'native-command': 'Command',
+  commands: 'Command',
+  snippets: 'Snippet',
+  'quick-links': 'Quicklink',
+  calculator: 'Calculator',
+  'color-converter': 'Color',
+}
+
+function searchResultKindLabel(item: SearchResult): string {
+  return SEARCH_CATEGORY_LABELS[item.category] ?? item.category
+}
+
+function searchResultIconAsset(item: SearchResult): {
+  kind: IconAssetKind
+  path: string
+} | null {
+  if (item.category === 'applications' && item.subtitle.endsWith('../../../src/renderer/.app')) {
+    return { kind: 'application', path: item.subtitle }
+  }
+  if (
+    (item.category === 'files' || item.category === 'knowledge') &&
+    item.action.type === 'open-file'
+  ) {
+    return { kind: 'file', path: item.action.path }
+  }
+  if (item.category === 'extensions' && item.action.type === 'run-extension-command') {
+    const rawId = item.action.extensionId || ''
+    const extId = normalizeIconKind(rawId)
+    const appPath = KNOWN_EXTENSION_APP_MAP[extId]
+    if (appPath) {
+      return { kind: 'application', path: appPath }
+    }
+    if (item.action.iconPath) {
+      return { kind: 'extension', path: item.action.iconPath }
+    }
+  }
+  return null
+}

+function isValidStoredAccelerator(accelerator: string): boolean {
+  return (
+    accelerator.length > 0 &&
+    /^[\x20-\x7E]+$/.test(accelerator) &&
+    accelerator.split('+').every((part) => part.trim().length > 0)
+  )

+
+export function normalizeIconKind(kind: string): string {
+  return kind
+    .toLowerCase()
+    .trim()
+    .replace(/^com\.tezbar\.native\./, '')
+    .replace(/^raycast\./, '')
+    .replace(/^com\.tezbar\./, '')
+}
+
+export function hasCustomLauncherIcon(kind: string): boolean {
+  const normalized = normalizeIconKind(kind)
+  return normalized in ICONS || kind in ICONS
+}
+
+export function launcherIcon(kind: string): { color: string; glyph: ReactNode } {
+  const normalized = normalizeIconKind(kind)
+  if (ICONS[normalized]) return ICONS[normalized]
+  if (ICONS[kind]) return ICONS[kind]
+
+  // Dynamic deterministic squircle for arbitrary extension slugs
+  const color = COLOR_PALETTE[hashString(normalized) % COLOR_PALETTE.length] ?? BLUE
+  return { color, glyph: BLOCKS }
+}
+
+export function LauncherGlyph({
+  kind,
+  size = 14,
+}: {
+  kind: string
+  size?: number
+}): JSX.Element {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 24 24"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="2.1"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      aria-hidden
+    >
+      {launcherIcon(kind).glyph}
+    </svg>
+  )
+}
+
+/** Solid colored squircle with a white glyph — the shared list icon tile. */
+export function Squircle({
+  kind,
+  size = 22,
+  className,
+}: {
+  kind: string
+  size?: number
+  className?: string
+}): JSX.Element {
+  const icon = launcherIcon(kind)
+  return (
+    <span
+      aria-hidden
+      className={cx('squircle grid shrink-0 place-items-center text-white', className)}
+      style={{
+        width: size,
+        height: size,
+        borderRadius: Math.round(size * 0.27),
+        backgroundColor: icon.color,
+      }}
+    >
+      <LauncherGlyph kind={kind} size={Math.round(size * 0.58)} />
+    </span>
+  )
+}
+
+export function chatIconToSquircleKind(icon?: string | null): string {
+  if (!icon) return 'chat'
+  const trimmed = icon.trim().toLowerCase()
+  switch (trimmed) {
+    case '⚡':
+    case 'code':
+    case 'coding':
+    case 'dev':
+    case 'mcp':
+    case 'script':
+      return 'snippets'
+    case '🔑':
+    case 'key':
+    case 'api-key':
+    case 'apikey':
+    case 'token':
+    case 'auth':
+    case 'password':
+      return 'key'
+    case '💻':
+    case 'cpu':
+    case 'hardware':
+    case 'system':
+    case 'mac':
+    case 'pc':
+      return 'cpu'
+    case '⚽':
+    case '🏀':
+    case '🎾':
+    case 'sport':
+    case 'sports':
+    case 'football':
+    case 'soccer':
+    case 'messi':
+    case 'ronaldo':
+    case 'trophy':
+      return 'trophy'
+    case '📝':
+    case '✍️':
+    case 'edit':
+    case 'pencil':
+    case 'draft':
+    case 'notes':
+    case 'note':
+    case 'writing':
+      return 'edit'
+    case '🤖':
+    case 'ai':
+    case 'llm':
+    case 'sparkles':
+      return 'ai'
+    case '📋':
+    case 'clipboard':
+      return 'clipboard'
+    case '☀️':
+    case 'weather':
+    case 'sun':
+      return 'weather'
+    case '🎵':
+    case 'music':
+    case 'audio':
+      return 'audio'
+    case '💰':
+    case 'finance':
+    case 'crypto':
+    case 'money':
+      return 'brew'
+    case '🔍':
+    case 'search':
+    case 'web':
+      return 'search'
+    case '⚙️':
+    case 'settings':
+    case 'config':
+      return 'settings'
+    case '📁':
+    case 'folder':
+    case 'files':
+      return 'finder'
+    case '💬':
+    case 'chat':
+      return 'chat'
+    default:
+      if (hasCustomLauncherIcon(trimmed)) return trimmed
+      return 'chat'
+  }
+}
+
+/** Solid colored squircle with a white glyph for chat sessions */

+    ),
+  },
+  {
+    id: 'count',
+    label: 'Count',
+    glyph: (
+      <svg width="11" height="11" viewBox="0 0 14 14" fill="none" stroke="currentColor" strokeWidth="1.2" strokeLinecap="round" strokeLinejoin="round" aria-hidden>
+        <path d="M3 2.5h8M3 7h8M3 11.5h5" />
+      </svg>

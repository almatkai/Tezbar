-export function acquireExtensionImage(
-  src: string,
-  variant: ExtensionImageVariant
-): ExtensionImageLease {
-  const normalized = extensionImageSource(src)
-  const direct = (): ExtensionImageLease => ({
-    source: Promise.resolve(normalized),
-    release: () => undefined,

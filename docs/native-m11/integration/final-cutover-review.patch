+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+/* =========================================================================
+   Tezbar Design System
+   -------------------------------------------------------------------------
+   All visual tokens flow from here. Components compose these tokens via
+   utility classes and the `@layer components` block below.
+   ========================================================================= */
+@layer base {
+  :root {
+    /* Radius — concentric scale so nested shapes stay visually aligned.
+       The outer window is 8px larger than any element sitting directly
+       inside it (surfaces inset the window by 8px), so inner corners
+       appear visually parallel to the window corner. Each subsequent
+       level steps down by ~4–6px to keep the hierarchy readable.
+       window (card + 8px inset) ⟶ panel / card (16) ⟶ row (10) ⟶ field (8) ⟶ chip (6) */
+    --r-window: calc(var(--r-card) + var(--s-2));
+    --r-panel: 16px;
+    --r-card: 16px;
+    --r-row: 10px;
+    --r-field: 8px;
+    --r-chip: 6px;
+
+    /* Spacing — 4px base scale */
+    --s-1: 4px;
+    --s-2: 8px;
+    --s-3: 12px;
+    --s-4: 16px;
+    --s-5: 20px;
+    --s-6: 24px;
+
+    /* Surface colors (RGB triplets for tailwind alpha) */
+    --c-shell: 10 11 14;
+    --c-panel: 18 20 26;
+    --c-row: 255 255 255;
+
+    /* Text ramp */
+    --c-text-1: 245 246 250;
+    --c-text-2: 188 190 200;
+    --c-text-3: 134 138 150;
+    --c-text-4: 94 98 112;
+
+    /* Accent — soft violet-indigo, refined */
+    --c-accent: 139 141 247;
+    --c-accent-strong: 168 170 255;
+
+    /* Semantic */
+    --c-success: 52 211 153;
+    --c-danger: 248 113 113;
+    --c-warning: 251 191 36;
+    --c-theme-line: 255 255 255;
+    --c-theme-control: 255 255 255;
+    --c-theme-control-hover: 255 255 255;
+
+    /* Shadows intentionally omitted — the design relies on 1px inset
+       borders for edge definition, not drop shadows. */
+  }
+
+  :root[data-theme='white'] {
+    --c-shell: 241 244 249;
+    --c-panel: 255 255 255;
+    --c-row: 255 255 255;
+    --c-text-1: 27 37 57;
+    --c-text-2: 62 76 101;
+    --c-text-3: 91 106 129;
+    --c-text-4: 99 113 135;
+    --c-accent: 76 68 193;
+    --c-accent-strong: 62 53 165;
+    --c-success: 5 150 105;
+    --c-danger: 220 38 38;
+    --c-warning: 217 119 6;
+    --c-theme-line: 97 113 140;
+    --c-theme-control: 243 246 251;
+    --c-theme-control-hover: 230 235 246;
+    color-scheme: light;
+  }
+
+  html,
+  body {
+    background: transparent !important;
+    font-family:
+      'Geist',
+      -apple-system,
+      BlinkMacSystemFont,
+      'Segoe UI',
+      sans-serif;
+    font-feature-settings: 'cv11', 'ss01', 'ss03';
+    letter-spacing: -0.005em;
+    -webkit-user-select: none;
+    user-select: none;
+  }
+
+  /* Prevent drag ghosting on links, images, icons, and text during window drag */
+  *,
+  *::before,
+  *::after {
+    -webkit-user-drag: none;
+  }
+
+  /* Allow text selection only in editable input controls and explicitly marked content */
+  input,
+  textarea,
+  [contenteditable='true'] {
+    -webkit-user-select: text;
+    user-select: text;
+  }
+
+  .select-text,
+  [data-selectable='true'],
+  .tezbar-md {
+    -webkit-user-select: text;
+    user-select: text;
+  }
+
+  .select-none,
+  [data-selectable='false'] {
+    -webkit-user-select: none !important;
+    user-select: none !important;
+  }
+
+  button,
+  [role='button'],
+  [role='menuitem'],
+  [role='option'],
+  [role='tab'],
+  kbd {
+    -webkit-user-select: none;
+    user-select: none;
+  }
+
+  * {
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+  }
+
+  /* Smooth scrolling for every scrollable region */
+  html {
+    scroll-behavior: smooth;
+  }
+
+  /* Thin, subtle scrollbars that match the glass aesthetic */
+  *::-webkit-scrollbar {
+    width: 8px;
+    height: 8px;
+  }
+
+  *::-webkit-scrollbar-track {
+    background: transparent;
+  }
+
+  *::-webkit-scrollbar-thumb {
+    background: rgba(255, 255, 255, 0.08);
+    border-radius: 999px;
+    border: 2px solid transparent;
+    background-clip: padding-box;
+    transition: background 220ms ease;
+  }

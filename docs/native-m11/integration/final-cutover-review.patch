+                  onFocus={() => setActiveId(entry.id)}
+                  onClick={() => choose(entry.id)}
+                  onKeyDown={(event) => {
+                    if (event.key === 'Enter') {
+                      event.preventDefault()
+                      choose(entry.id)
+                      return
+                    }
+                    const offset = { ArrowRight: 1, ArrowLeft: -1, ArrowDown: 8, ArrowUp: -8 }[

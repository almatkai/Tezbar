+  // The model chip mirrors the real bar's model picker.
+  useEffect(() => {
+    if (!aiReady) {
+      setChatModel(null)
+      return
+    }
+    void window.tezbar
+      .getLlmConfig()
+      .then((cfg) => setChatModel(cfg.taskModelOverrides?.chat ?? cfg.model ?? null))
+      .catch(() => setChatModel(null))
+  }, [aiReady])

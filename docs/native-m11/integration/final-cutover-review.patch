-function hotkeyDisplay(accelerator: string): string {
-  const labels: Record<string, string> = {
-    Alt: '⌥',
-    Command: '⌘',
-    CommandOrControl: navigator.platform.includes('Mac') ? '⌘' : 'Ctrl',
-    Control: '⌃',
-    Shift: '⇧',
-    Space: 'Space',
-    Up: '↑',
-    Down: '↓',
-    Left: '←',
-    Right: '→',
-  }
-  return accelerator
-    .split('+')
-    .map((part) => labels[part] ?? part)
-    .join(' ')
-}

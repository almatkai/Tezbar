-function tildify(path: string): string {
-  const home = path.match(/^(\/Users\/[^/]+|\/home\/[^/]+|[A-Z]:\\Users\\[^\\]+)/)?.[1]
-  return home ? `~${path.slice(home.length)}` : path
-}

-
-  try {
-    const parsed = JSON.parse(raw) as unknown
-    if (!Array.isArray(parsed)) return []
-    return parsed
-      .filter(
-        (item): item is string =>
-          typeof item === 'string' && item.length > 0 && item.trim().length > 0
-      )
-      .slice(0, LAUNCHER_QUERY_HISTORY_LIMIT)
-  } catch {
-    return []
-  }
-}

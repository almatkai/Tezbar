+    pub generation: u64,
+}
+impl Default for BackendStatus {
+    fn default() -> Self {
+        Self {
+            phase: "starting".into(),
+            detail: "Starting Rust core…".into(),
+            revision: 0,
+            generation: 0,
+        }
+    }
+}

+  :root[data-theme='white'] .command-result-icon.text-rose-200 {
+    color: #ad3653;
+    border-color: #e8afbd;
+    background: #fff0f3;
+  }
+
+  .theme-choice {
+    border-color: rgb(var(--c-theme-line) / 0.22);
+    background: rgb(var(--c-theme-control) / 0.08);
+    color: rgb(var(--c-text-2));
+  }
+
+  .theme-choice:hover {
+    border-color: rgb(var(--c-theme-line) / 0.36);
+    background: rgb(var(--c-theme-control-hover) / 0.14);
+    color: rgb(var(--c-text-1));
+  }
+
+  .theme-choice[aria-pressed='true'],
+  .theme-choice[aria-pressed='true']:hover {
+    border-color: rgb(var(--c-accent));
+    background: rgb(var(--c-accent));
+    color: #fff;
+    box-shadow: 0 0 0 2px rgb(var(--c-accent) / 0.18);
+  }
+
+  .theme-choice__check {
+    background: rgba(255, 255, 255, 0.22);
+    color: #fff;
+  }
+
+  :root[data-theme='white'] .theme-choice {
+    background: rgba(255, 255, 255, 0.72);
+  }
+
+  :root[data-theme='white'] .theme-choice:hover {
+    background: #fff;
+  }
+
+  :root[data-theme='white'] .theme-choice[aria-pressed='true'],
+  :root[data-theme='white'] .theme-choice[aria-pressed='true']:hover {
+    background: rgb(var(--c-accent));
+  }
+
+  /* ---- CleanMyMac-style sidebar ---- */
+  .cleanmymac-sidebar {
+    -webkit-app-region: no-drag;
+    border-top-left-radius: var(--r-window);
+    border-bottom-left-radius: var(--r-window);
+    border-top-right-radius: 0;
+    border-bottom-right-radius: 0;
+    scrollbar-width: none;
+    background:
+      linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0%, rgba(255, 255, 255, 0) 30%),
+      rgba(8, 9, 14, 0.55);
+    backdrop-filter: blur(36px) saturate(180%);
+    -webkit-backdrop-filter: blur(36px) saturate(180%);
+  }
+
+  .cleanmymac-sidebar::-webkit-scrollbar {
+    display: none;
+  }
+
+  .cleanmymac-sidebar > * {
+    -webkit-app-region: no-drag;
+  }
+
+  :root[data-theme='white'] .cleanmymac-sidebar {
+    border-right-color: rgba(76, 94, 125, 0.16);
+    background: rgba(226, 233, 244, 0.66);
+  }
+
+  :root[data-theme='white'] .cleanmymac-sidebar [aria-current='page'] {
+    background: rgba(255, 255, 255, 0.86);
+    color: rgb(var(--c-text-1));
+    box-shadow:
+      inset 0 0 0 1px rgba(76, 94, 125, 0.14),
+      0 2px 6px rgba(34, 48, 76, 0.04);
+  }
+
+  /* A transparent, click-through work-area overlay renders the fixed
+     centered target frame while the launcher moves independently. */
+  .snap-overlay {
+    position: relative;
+    width: 100vw;
+    height: 100vh;
+    pointer-events: none;
+    opacity: 0;
+    transition: opacity 120ms ease;
+  }
+
+  .snap-overlay.is-visible {
+    opacity: 1;
+  }
+
+  .snap-overlay__edge {
+    position: absolute;
+    box-sizing: border-box;
+    opacity: 0.4;
+    background: rgba(26, 28, 62, 0.88);
+    border: 1px solid rgba(10, 12, 26, 0.9);
+    box-shadow:
+      inset 0 0 0 1px rgba(96, 98, 180, 0.14),
+      0 0 0 1px rgba(17, 19, 45, 0.78),
+      0 0 12px rgba(42, 44, 130, 0.42),
+      0 0 24px rgba(22, 24, 90, 0.24);
+    transition:
+      background 120ms ease,
+      box-shadow 120ms ease,
+      opacity 120ms ease;
+  }
+
+  .snap-overlay__edge--left,
+  .snap-overlay__edge--right {
+    left: 0;
+    top: 0;
+    bottom: 0;
+    width: 8px;
+  }
+
+  .snap-overlay__edge--top,
+  .snap-overlay__edge--bottom {
+    top: 0;
+    left: 0;
+    right: 0;
+    height: 8px;
+  }
+
+  .snap-overlay.is-snapped-x .snap-overlay__edge--left,
+  .snap-overlay.is-snapped-x .snap-overlay__edge--right,
+  .snap-overlay.is-snapped-y .snap-overlay__edge--top,
+  .snap-overlay.is-snapped-y .snap-overlay__edge--bottom {
+    opacity: 0.56;
+    background: rgba(35, 37, 84, 0.92);
+    border-color: rgba(12, 14, 32, 0.94);
+    box-shadow:
+      inset 0 0 0 1px rgba(102, 104, 205, 0.2),
+      0 0 0 1px rgba(20, 22, 54, 0.84),
+      0 0 14px rgba(48, 50, 150, 0.48),
+      0 0 28px rgba(25, 27, 104, 0.3);
+  }
+
+  .snap-overlay.is-centered .snap-overlay__edge {
+    opacity: 0.68;
+    background: rgba(47, 49, 108, 0.94);
+    border-color: rgba(14, 16, 38, 0.96);
+    box-shadow:
+      inset 0 0 0 1px rgba(118, 120, 228, 0.24),
+      0 0 0 1px rgba(25, 27, 68, 0.9),
+      0 0 16px rgba(56, 58, 170, 0.56),
+      0 0 32px rgba(28, 30, 120, 0.36);
+  }
+
+  .snap-overlay__center-indicator {
+    position: absolute;
+    top: 50%;
+    left: 50%;
+    width: 10px;
+    height: 10px;
+    border: 1px solid rgba(196, 197, 255, 0.88);
+    border-radius: 999px;
+    opacity: 0;
+    transform: translate(-50%, -50%);
+    box-shadow: 0 0 0 3px rgba(139, 141, 247, 0.12);
+    transition: opacity 120ms ease;
+  }
+
+  .snap-overlay.is-centered .snap-overlay__center-indicator {
+    opacity: 1;
+    animation: snap-center-pulse 1.1s ease-in-out infinite;
+  }
+
+  @keyframes snap-center-pulse {
+    0%,
+    100% {
+      box-shadow: 0 0 0 3px rgba(139, 141, 247, 0.12);
+    }
+    50% {
+      box-shadow: 0 0 0 6px rgba(139, 141, 247, 0.24);
+    }
+  }
+
+  /* Inset section — lighter glass for grouping inside a card */
+  .glass-inset {
+    border-radius: var(--r-row);
+    background: rgba(255, 255, 255, 0.025);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
+  }
+
+  /* ---- Input primitives ---- */
+  .glass-field {
+    width: 100%;
+    border-radius: var(--r-field);
+    padding: 0.5rem 0.75rem;
+    background: rgba(0, 0, 0, 0.28);
+    color: rgb(var(--c-text-1));
+    font-size: 13px;
+    line-height: 1.25rem;
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
+    transition:
+      box-shadow var(--dur-base, 220ms) cubic-bezier(0.22, 1, 0.36, 1),
+      background var(--dur-base, 220ms) cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  .glass-field::placeholder {
+    color: rgb(var(--c-text-4));
+  }
+
+  .glass-field:hover {
+    background: rgba(0, 0, 0, 0.35);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
+  }
+
+  .glass-field:focus,
+  .glass-field:focus-visible {
+    background: rgba(0, 0, 0, 0.4);
+    box-shadow: inset 0 0 0 1px rgba(139, 141, 247, 0.55);
+  }
+
+  /* ---- Buttons ---- */
+  .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 0.4rem;
+    padding: 0.4rem 0.85rem;
+    border-radius: var(--r-row);
+    font-size: 12px;
+    font-weight: 500;
+    line-height: 1;
+    color: rgb(var(--c-text-1));
+    letter-spacing: -0.005em;
+    transition:
+      background 160ms cubic-bezier(0.22, 1, 0.36, 1),
+      box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1),
+      transform 160ms cubic-bezier(0.22, 1, 0.36, 1),
+      color 160ms cubic-bezier(0.22, 1, 0.36, 1),
+      opacity 160ms cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  .btn:active:not(:disabled) {
+    transform: scale(0.97);
+  }
+
+  .btn:disabled {
+    opacity: 0.45;
+    cursor: not-allowed;
+  }
+
+  .btn-primary {
+    background:
+      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 100%),
+      rgb(118, 120, 240);
+    box-shadow:
+      0 1px 0 rgba(255, 255, 255, 0.2) inset,
+      0 -1px 0 rgba(0, 0, 0, 0.15) inset;
+  }
+
+  .btn-primary:hover:not(:disabled) {
+    background:
+      linear-gradient(180deg, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 100%),
+      rgb(139, 141, 247);
+    box-shadow:
+      0 1px 0 rgba(255, 255, 255, 0.25) inset,
+      0 -1px 0 rgba(0, 0, 0, 0.15) inset;
+  }
+
+  .btn-ghost {
+    background: rgba(255, 255, 255, 0.05);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
+  }
+
+  .btn-ghost:hover:not(:disabled) {
+    background: rgba(255, 255, 255, 0.09);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
+  }
+
+  .btn-danger {
+    background: rgba(248, 113, 113, 0.12);
+    color: rgb(var(--c-danger));
+    box-shadow: inset 0 0 0 1px rgba(248, 113, 113, 0.3);
+  }
+
+  .btn-danger:hover:not(:disabled) {
+    background: rgba(248, 113, 113, 0.2);
+    box-shadow: inset 0 0 0 1px rgba(248, 113, 113, 0.5);
+  }
+
+  .btn-quiet {
+    padding: 0.35rem 0.65rem;
+    background: transparent;
+    color: rgb(var(--c-text-3));
+    font-size: 11px;
+  }
+
+  .btn-quiet:hover:not(:disabled) {
+    background: rgba(255, 255, 255, 0.06);
+    color: rgb(var(--c-text-1));
+  }
+
+  /* ---- Keyboard hint ---- */
+  .kbd {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 16px;
+    height: 16px;
+    padding: 0 0.3rem;
+    font-family: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
+    font-size: 9px;
+    font-weight: 500;
+    line-height: 1;
+    color: rgb(var(--c-text-2));
+    border-radius: var(--r-chip);
+    background: rgba(255, 255, 255, 0.06);
+    box-shadow:
+      inset 0 0 0 1px rgba(255, 255, 255, 0.08),
+      inset 0 -1px 0 rgba(0, 0, 0, 0.2);
+  }
+
+  /* ---- Row hover states (list items) ---- */
+  .row-interactive {
+    position: relative;
+    transition:
+      background 180ms cubic-bezier(0.22, 1, 0.36, 1),
+      box-shadow 180ms cubic-bezier(0.22, 1, 0.36, 1),
+      color 180ms cubic-bezier(0.22, 1, 0.36, 1);
+  }
+
+  .row-interactive:hover {
+    background: rgba(255, 255, 255, 0.04);
+  }
+
+  .row-interactive[data-selected='true'] {
+    background: rgba(255, 255, 255, 0.07);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
+  }
+
+  /* ---- Sliding selection highlight (travels between rows) ----
+     Mirrors the pinned-button style: neutral 1px white border +
+     subtle white fill, nothing accent-colored. */
+  .glide-highlight {
+    position: absolute;
+    top: 0;
+    left: 0;
+    right: 0;
+    pointer-events: none;
+    border-radius: var(--r-row);
+    background: rgba(255, 255, 255, 0.07);
+    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
+    transition:
+      transform 100ms cubic-bezier(0.16, 1, 0.3, 1),
+      height 100ms cubic-bezier(0.16, 1, 0.3, 1),
+      opacity 80ms ease-out;
+    will-change: transform, height;
+    z-index: 0;
+  }
+
+  /* ---- Status dots (animated "connected") ---- */
+  .status-dots {
+    display: inline-flex;
+    align-items: center;
+    gap: 3px;
+  }
+
+  .status-dots > span {
+    width: 5px;
+    height: 5px;
+    border-radius: 9999px;
+    background: rgb(var(--c-success));
+    animation: tezbar-conn-pulse 1.2s ease-in-out infinite;
+  }
+
+  .status-dots > span:nth-child(2) {
+    animation-delay: 0.2s;
+  }
+
+  .status-dots > span:nth-child(3) {
+    animation-delay: 0.4s;
+  }
+
+  /* ---- Divider ---- */
+  .hairline {
+    height: 1px;
+    background: linear-gradient(
+      90deg,
+      transparent,
+      rgba(255, 255, 255, 0.08) 12%,
+      rgba(255, 255, 255, 0.08) 88%,
+      transparent
+    );
+  }
+}
+
+/* =========================================================================
+   Animations
+   ========================================================================= */
+@keyframes tezbar-conn-pulse {
+  0%,
+  100% {
+    opacity: 0.35;
+    transform: scale(0.85);
+  }
+
+  50% {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+@keyframes tezbar-thinking {
+  0%,
+  100% {
+    opacity: 0.4;
+  }
+
+  50% {
+    opacity: 1;
+  }
+}
+
+@keyframes tezbar-rolling-hint {
+  0% {
+    opacity: 0;
+    transform: translateY(8px);
+    filter: blur(2px);
+  }
+
+  12%,
+  82% {
+    opacity: 1;
+    transform: translateY(0);
+    filter: blur(0);
+  }
+
+  100% {
+    opacity: 0;
+    transform: translateY(-8px);
+    filter: blur(2px);
+  }
+}
+
+.tezbar-thinking {
+  animation: tezbar-thinking 1.4s ease-in-out infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .rolling-command-hint__item {
+    animation: none;
+  }
+}
+
+/* Stagger helpers — applied to list items for on-mount cascade */
+.stagger > * {
+  opacity: 0;
+  animation: tezbar-fade-up 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+.stagger > *:nth-child(1) {
+  animation-delay: 20ms;
+}
+
+.stagger > *:nth-child(2) {
+  animation-delay: 40ms;
+}
+
+.stagger > *:nth-child(3) {
+  animation-delay: 60ms;
+}
+
+.stagger > *:nth-child(4) {
+  animation-delay: 80ms;
+}
+
+.stagger > *:nth-child(5) {
+  animation-delay: 100ms;
+}
+
+.stagger > *:nth-child(6) {
+  animation-delay: 120ms;
+}
+
+.stagger > *:nth-child(7) {
+  animation-delay: 140ms;
+}
+
+.stagger > *:nth-child(8) {
+  animation-delay: 160ms;
+}
+
+.stagger > *:nth-child(n + 9) {
+  animation-delay: 180ms;
+}
+
+@keyframes tezbar-fade-up {
+  0% {
+    opacity: 0;
+    transform: translateY(4px);
+  }
+
+  100% {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes tezbar-pin-rail-in {
+  0% {
+    opacity: 0;
+    transform: translateX(-8px);
+  }
+
+  100% {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+
+/* =========================================================================
+   Onboarding — first-run setup. Motion only answers what the person did
+   (a step change, a check landing, a key being recorded).
+   ========================================================================= */
+.onboarding-step-forward {
+  animation: tezbar-step-in-forward 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+.onboarding-step-back {
+  animation: tezbar-step-in-back 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@keyframes tezbar-step-in-forward {
+  0% {
+    opacity: 0;
+    transform: translateX(12px);
+  }
+
+  100% {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+
+@keyframes tezbar-step-in-back {
+  0% {
+    opacity: 0;
+    transform: translateX(-12px);
+  }
+
+  100% {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
+
+/* Drifting glow behind the app icon on the welcome splash. */
+.onboarding-orb {
+  animation: tezbar-orb-drift 7s ease-in-out infinite;
+}
+
+@keyframes tezbar-orb-drift {
+  0%,
+  100% {
+    transform: translate(0, 0) scale(1);
+    opacity: 0.55;
+  }
+
+  50% {
+    transform: translate(6px, -6px) scale(1.08);
+    opacity: 0.85;
+  }
+}
+
+.onboarding-splash-exit {
+  animation: tezbar-splash-exit 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@keyframes tezbar-splash-exit {
+  to {
+    opacity: 0;
+    transform: scale(1.06);
+  }
+}
+
+.onboarding-splash-hint {
+  opacity: 0;
+  animation: tezbar-fade-up 400ms cubic-bezier(0.22, 1, 0.36, 1) 900ms both;
+}
+
+/* Content that swaps in as the practice bar's response changes. */
+.onboarding-cycle-in {
+  animation: tezbar-fade-up 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+/* A check landing on a finished step or task. */
+.onboarding-chip-pop {
+  animation: tezbar-chip-pop 320ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@keyframes tezbar-chip-pop {
+  0% {
+    opacity: 0;
+    transform: scale(0.6);
+  }
+
+  60% {
+    opacity: 1;
+    transform: scale(1.15);
+  }
+
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+/* Large physical-looking key caps for the global shortcut. */
+.onboarding-keycap {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 52px;
+  height: 52px;
+  padding: 0 16px;
+  border-radius: 12px;
+  background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.14),
+    inset 0 0 0 1px rgba(255, 255, 255, 0.1),
+    0 3px 0 rgba(0, 0, 0, 0.35),
+    0 6px 16px rgba(0, 0, 0, 0.25);
+  font-size: 20px;
+  font-weight: 500;
+  color: rgb(var(--c-text-1));
+  animation: tezbar-chip-pop 240ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+.onboarding-keystage.is-recording {
+  box-shadow: 0 0 0 4px rgb(var(--c-accent) / 0.08);
+}
+
+:root[data-theme='white'] .onboarding-keycap {
+  background: linear-gradient(180deg, #fff, rgba(241, 245, 251, 0.95));
+  box-shadow:
+    inset 0 0 0 1px rgba(76, 94, 125, 0.2),
+    0 3px 0 rgba(76, 94, 125, 0.18),
+    0 6px 14px rgba(34, 48, 76, 0.08);
+}
+
+/* Inline path / command inside practice-bar explanations. */
+.onboarding-code {
+  padding: 1px 5px;
+  border-radius: 5px;
+  background: rgba(255, 255, 255, 0.06);
+  font-family: var(--font-mono, ui-monospace, monospace);
+  font-size: 0.92em;
+  color: rgb(var(--c-text-1));
+}
+
+/* Practice bar. One border, tinted by mode like the real bar's icon colour.
+   The only motion is a single puff when the mode switches. */
+.onboarding-bar-surface {
+  background: rgb(var(--c-shell));
+  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
+  transition: box-shadow 250ms ease;
+}
+
+.onboarding-bar.is-ai .onboarding-bar-surface {
+  box-shadow: inset 0 0 0 1px rgb(167 139 250 / 0.45);
+}
+
+.onboarding-bar.is-terminal .onboarding-bar-surface {
+  box-shadow: inset 0 0 0 1px rgb(52 211 153 / 0.45);
+}
+
+.onboarding-puff-burst {
+  position: absolute;
+  top: 50%;
+  left: 24px;
+  pointer-events: none;
+}
+
+.onboarding-puff {
+  position: absolute;
+  top: 0;
+  left: 0;
+  border-radius: 9999px;
+  filter: blur(6px);
+  opacity: 0;
+  animation: onboarding-puff 700ms cubic-bezier(0.16, 0.84, 0.3, 1) both;
+}
+
+@keyframes onboarding-puff {
+  0% {
+    opacity: 0;
+    transform: translate(-50%, -50%) scale(0.3);
+  }
+
+  25% {
+    opacity: 0.45;
+  }
+
+  100% {
+    opacity: 0;
+    transform: translate(calc(-50% + var(--puff-x)), calc(-50% + var(--puff-y))) scale(1.4);
+  }
+}
+
+:root[data-theme='white'] .onboarding-bar-surface {
+  background: rgb(var(--c-panel));
+  box-shadow: inset 0 0 0 1px rgba(76, 94, 125, 0.2);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .onboarding-orb,
+  .onboarding-step-forward,
+  .onboarding-step-back,
+  .onboarding-keycap,
+  .onboarding-chip-pop,
+  .onboarding-cycle-in {
+    animation: none;
+  }
+
+  .onboarding-puff-burst {
+    display: none;
+  }
+}
+
+/* =========================================================================
+   Markdown — `.tezbar-md` is the wrapper produced by <Markdown /> and holds
+   every rich-text rule used by agent / answer streams. Kept tight (no big
+   vertical margins) to fit the HUD, but supports code, tables, lists,
+   blockquotes and task checkboxes.
+   ========================================================================= */
+.tezbar-md {
+  font-size: 13.5px;
+  line-height: 1.55;
+  color: var(--ink-1, #f3efff);

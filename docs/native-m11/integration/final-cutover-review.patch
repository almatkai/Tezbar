+  const cleaned = withoutScripts.replace(/<(\/?)([a-z0-9-]+)(?:\s[^>]*)?>/gi, (_full, slash, tag) => {
+    const name = String(tag).toLowerCase()
+    if (!ALLOWED_RICH_TAGS.has(name)) return ''
+    return `<${slash}${name}>`
+  })

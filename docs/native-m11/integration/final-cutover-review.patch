+  const button =
+    'rounded-lg border border-white/10 bg-white/5 px-2.5 py-1.5 text-xs text-ink-2 hover:bg-white/10 focus-visible:ring-1 focus-visible:ring-cyan-300/50 disabled:opacity-40'
+  return (

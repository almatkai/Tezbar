+use std::process::Command;
+fn main() {
+    let compiler = Command::new(std::env::var_os("RUSTC").expect("Cargo RUSTC"))
+        .arg("-vV")
+        .output()
+        .expect("compiler identity");
+    assert!(compiler.status.success());
+    let compiler = String::from_utf8(compiler.stdout).expect("UTF-8 rustc version");
+    let commit = compiler
+        .lines()
+        .find_map(|line| line.strip_prefix("commit-hash: "))
+        .expect("compiler commit");
+    println!("cargo:rustc-env=TEZBAR_PROTOTYPE_RUSTC={commit}");
+    println!("cargo:rerun-if-env-changed=TEZBAR_PROTOTYPE_SOURCE_SHA");
+    for path in ["src", "Cargo.toml", "Cargo.lock", "../../src-tauri/src"] {
+        println!("cargo:rerun-if-changed={path}");
+    }
+    let git = |args: &[&str]| {
+        Command::new("git")
+            .args(args)
+            .output()
+            .ok()
+            .filter(|o| o.status.success())
+            .map(|o| String::from_utf8_lossy(&o.stdout).trim().to_owned())
+    };
+    let sha = std::env::var("TEZBAR_PROTOTYPE_SOURCE_SHA")
+        .ok()
+        .or_else(|| git(&["rev-parse", "HEAD"]))
+        .expect("Git SHA or TEZBAR_PROTOTYPE_SOURCE_SHA required");
+    assert!(
+        sha.len() == 40 && sha.bytes().all(|b| b.is_ascii_hexdigit()),
+        "40-hex source SHA required"
+    );
+    if let Some(path) = git(&["rev-parse", "--git-path", "HEAD"]) {
+        println!("cargo:rerun-if-changed={path}");
+    }
+    if let Some(branch) = git(&["symbolic-ref", "HEAD"]) {
+        if let Some(path) = git(&["rev-parse", "--git-path", &branch]) {
+            println!("cargo:rerun-if-changed={path}");
+        }
+    }
+    println!("cargo:rustc-env=TEZBAR_PROTOTYPE_GIT_SHA={sha}");
+    println!(
+        "cargo:rustc-env=TEZBAR_PROTOTYPE_DIRTY={}",
+        git(&["status", "--porcelain"])
+            .map(|v| !v.is_empty())
+            .unwrap_or(false)
+    );
+}

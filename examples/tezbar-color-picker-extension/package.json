{
  "$schema": "https://tezbar.dev/schemas/extension-v1.json",
  "id": "com.tezbar.color-picker",
  "name": "tezbar-color-picker",
  "title": "Color Picker",
  "description": "Pick an exact pixel from any screen and inspect it in RGB, HEX, HSL, HSV, and CSS formats.",
  "version": "0.1.0",
  "author": "Tezbar",
  "icon": "assets/icon.svg",
  "categories": [
    "Design",
    "Developer Tools"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "pick-color",
      "title": "Pick Color",
      "description": "Open the native screen sampler and inspect the selected color.",
      "mode": "view",
      "keywords": [
        "color",
        "colour",
        "eyedropper",
        "pixel",
        "hex",
        "rgb"
      ]
    }
  ],
  "screenshots": [
    "assets/picker-preview.png",
    "assets/color-wheel-preview.png"
  ],
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "windows",
      "macos"
    ],
    "linuxStatus": "coming-soon",
    "minTezbarVersion": "0.3.0",
    "permissions": [
      "screen-recording",
      "clipboard"
    ],
    "repository": "https://github.com/almatkai/tezbar-color-picker-extension",
    "release": {
      "provider": "github",
      "artifactPattern": "tezbar-color-picker-{version}-{platform}-{arch}.tar.gz"
    }
  }
}

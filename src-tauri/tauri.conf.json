{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tezbar",
  "version": "0.0.4",
  "identifier": "com.tezbar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "additionalWatchFolders": ["../dist-backend"],
    "beforeDevCommand": "pnpm exec tsx scripts/build-backend.ts && pnpm exec vite",
    "beforeBuildCommand": "pnpm exec tsx scripts/build-backend.ts && pnpm exec vite build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tezbar",
        "width": 760,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Tezbar Settings",
        "url": "index.html?window=settings",
        "width": 920,
        "height": 680,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDRUU3OUQ4RjU4MDk5Q0EKUldTbHk3YXRYUThqaXVFcFRUcy9TVmN0bGxCK0pnVGVUeHlBWmRLc1ZzYkxkTzJrZmNQYUFaMVQK",
      "endpoints": [
        "https://github.com/almatkai/Raymes/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-backend/main.js": "dist-backend/main.js",
      "../dist-backend/knowledge-worker.js": "dist-backend/knowledge-worker.js",
      "../dist-backend/vec0": "dist-backend/vec0",
      "../dist-backend/node_modules": "dist-backend/node_modules",
      "../resources/icons": "dist-backend/resources/icons",
      "../native/color-picker/windows.ps1": "native/color-picker/windows.ps1",
      "../native/image-colors/windows.ps1": "native/image-colors/windows.ps1",
      "../resources/trayIconTemplate@2x.png": "trayIconTemplate@2x.png"
    }
  }
}
